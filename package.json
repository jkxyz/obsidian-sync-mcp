{
  "name": "obsidian-sync-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "container"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspace container",
    "cf-typegen": "wrangler types",
    "check": "npm run cf-typegen && npm run typecheck && npm test && npm run deploy:dry-run",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:dry-run:worker": "wrangler deploy --dry-run --containers-rollout=none",
    "dev": "wrangler dev",
    "format:check": "prettier --check .",
    "test": "vitest run && npm test --workspace container",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace container"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.0",
    "jose": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=22"
  }
}
