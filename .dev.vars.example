# Copy this file to .dev.vars for local development and replace every value.
MCP_ALLOWED_HOSTNAMES="YOUR_WORKER_HOST"
ACCESS_CLIENT_ID="YOUR_ACCESS_CLIENT_ID"
ACCESS_CLIENT_SECRET="YOUR_ACCESS_CLIENT_SECRET"
ACCESS_AUTHORIZATION_URL="https://YOUR_TEAM.cloudflareaccess.com/cdn-cgi/access/sso/oidc/YOUR_APP_ID/authorization"
ACCESS_TOKEN_URL="https://YOUR_TEAM.cloudflareaccess.com/cdn-cgi/access/sso/oidc/YOUR_APP_ID/token"
ACCESS_JWKS_URL="https://YOUR_TEAM.cloudflareaccess.com/cdn-cgi/access/sso/oidc/YOUR_APP_ID/jwks"
COOKIE_ENCRYPTION_KEY="GENERATE_AN_INDEPENDENT_RANDOM_SECRET"
CREDENTIAL_ENCRYPTION_KEY="GENERATE_A_DIFFERENT_RANDOM_SECRET"
INTERNAL_CONTAINER_TOKEN="GENERATE_A_THIRD_RANDOM_SECRET"
